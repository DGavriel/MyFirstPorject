# ==========================================================================
# שער קדמי — נדחה לפני ש-PHP מתחיל
#
# ב-16/11/2026 תוקף שיגר 27,000 פניות ל-send.php, בשיא 1,910 בדקה.
# כולן נחסמו כמו שצריך, אבל כל חסימה הפעילה PHP וכתבה שורה ליומן.
# זה חרג ממגבלת ה-I/O של החשבון והפיל את האתר לשעות.
#
# הכלל שלמטה דוחה את אותן פניות כאן, בשרת עצמו: בלי PHP, בלי כתיבה
# לדיסק, בלי עומס. מה שעובר הלאה הוא מעט מספיק כדי לתעד אותו במלואו.
# ==========================================================================

<IfModule mod_rewrite.c>
RewriteEngine On

# דפדפן אמיתי ששולח טופס מהאתר נושא Origin או Referer של הדומיין.
# בקשה ישירה מסקריפט לא נושאת אף אחד מהם — וזו בדיוק ההתקפה.
RewriteCond %{HTTP:Origin}  !^https?://(www\.)?zhutko\.com$   [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?zhutko\.com/   [NC]
RewriteRule ^send\.php$ - [F,L]
</IfModule>

# היומן לא נגיש מהדפדפן
<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

# בלי רשימת קבצים
Options -Indexes
